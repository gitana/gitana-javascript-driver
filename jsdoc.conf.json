{
	"tags"      : {
		"allowUnknownTags" : true
	},
	"plugins"   : ["plugins/markdown"],

	"source"    : {
		"include" : ["js/gitana"]
	},

	"opts"      : {
		"destination" : "./dist/jsdoc",
		"readme"      : "README.md",
		"recurse"     : true,
		"template"    : "node_modules/clean-jsdoc-theme/dist",
		"siteName"    : "Cloud CMS JavaScript Driver"
	},

	"templates" : {
		"cleverLinks"    : false,
		"monospaceLinks" : false,
		"default"        : {
			"outputSourceFiles" : true
		}
	},
	"markdown"  : {
		"parser"   : "gfm",
		"hardwrap" : true
	}
}
