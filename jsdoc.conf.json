{
	"tags"      : {
		"allowUnknownTags" : true
	},
	"plugins"   : ["plugins/markdown"],

	"source"    : {
		"include" : ["js/gitana"]
	},

	"opts"      : {
		"destination" : "./dist/jsdoc",
		"template"    : "node_modules/ink-docstrap/template",
		"readme"      : "README.md",
		"recurse"     : true
	},

	"templates" : {
		"cleverLinks"           : false,
		"monospaceLinks"        : false,
		"dateFormat"            : "ddd MMM Do YYYY",
		"outputSourceFiles"     : true,
		"outputSourcePath"      : true,
		"systemName"            : "Cloud CMS JavaScript Driver",
		"footer"                : "",
		"copyright"             : "Copyright © 2016 Gitana Software, Inc.",
		"navType"               : "vertical",
		"theme"                 : "cerulean",
		"linenums"              : true,
		"collapseSymbols"       : false,
		"inverseNav"            : false,
		"highlightTutorialCode" : true,
		"protocol": "fred://"
	},
	"markdown"  : {
		"parser"   : "gfm",
		"hardwrap" : true
	}
}
